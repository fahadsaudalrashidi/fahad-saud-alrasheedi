# FastAPI container
PORT=8000
HOST=0.0.0.0
WEB_STATIC_DIR=./web

# Local defaults. For Docker, the image defaults to /data; if using this file,
# set these two paths to /data/... to persist them on the mounted volume.
SUPPORT_DB_PATH=./data/support.db
LINEAGE_LOG_PATH=./data/lineage_events.jsonl
SUPPORT_DATA_LABEL=Synthetic demonstration tickets

# Local mode is self-contained. Configure a reachable broker to enable Kafka.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=support-tickets

# SQLite serves dashboard data by default. Delta enables the Spark adapter.
LAKEHOUSE_MODE=sqlite
DELTA_LAKEHOUSE_PATH=./data/delta_lakehouse

# The built-in gate is lightweight; the optional quality extra enables GX.
QUALITY_MODE=builtin
OPENLINEAGE_MODE=file

# hash is lightweight and runs locally; transformer/multilingual use
# SentenceTransformers, Qdrant in-memory, and cross-encoder models from [rag].
RAG_MODE=hash

# Replit uses its managed OpenAI integration for generated answers.
# For standalone containers, the assistant returns grounded retrieval suggestions.
