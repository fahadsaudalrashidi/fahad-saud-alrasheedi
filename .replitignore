# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
.venv
node_modules
**/node_modules
**/dist
# These generated outputs are required by the production artifact run steps.
!artifacts/api-server/dist/
!artifacts/api-server/dist/**
!artifacts/support-intelligence/dist/
!artifacts/support-intelligence/dist/**
# The API starts its Python sidecar from this installed dependency directory.
!.pythonlibs/
!.pythonlibs/**
.cache
__pycache__
*.py[cod]

# Runtime state and local credentials must never be shipped with the app.
data/
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example
